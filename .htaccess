# Block sensitive files from public access
<FilesMatch "\.(csv|json|py|md|txt|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files "robots.txt">
    Order allow,deny
    Allow from all
</Files>

<Files "2ced74f4ca784c298761151b79504b00.txt">
    Order allow,deny
    Allow from all
</Files>

# IndexNow key (Bing/Yandex instant indexing via OpenSEO)
<Files "ed59a92129104e68ad6a303d9ee3d47c.txt">
    Order allow,deny
    Allow from all
</Files>

# Block .git directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git - [F,L]

    # SEO: every page has ONE address: https://oregoninformation.com/path/
    # (no www, no http, no index.html). Each rule sends visitors and search
    # engines straight to that address in a single 301 redirect.

    # /path/index.html -> /path/ (matches the canonical tags and sitemap).
    # THE_REQUEST only matches what the browser asked for, so DirectoryIndex lookups don't loop.
    RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
    RewriteRule ^ https://oregoninformation.com/%1 [R=301,L]

    # Folder without its trailing slash (/cities/bend) -> /cities/bend/ on the canonical
    # address in one hop (Apache's own slash redirect would point at http:// first).
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.+[^/])$ https://oregoninformation.com/$1/ [R=301,L]

    # www -> non-www, and http -> https.
    # The site is behind Cloudflare, so %{HTTPS} only says how Cloudflare reached this
    # server; X-Forwarded-Proto says what the visitor actually used. Checking the
    # visitor's scheme avoids a redirect loop whatever Cloudflare's SSL mode is.
    RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
    RewriteRule ^ https://oregoninformation.com%{REQUEST_URI} [R=301,L]

    # Plain-http requests that reach this server without going through Cloudflare.
    RewriteCond %{HTTP:X-Forwarded-Proto} ^$
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://oregoninformation.com%{REQUEST_URI} [R=301,L]
</IfModule>

# Ask proxies such as Cloudflare not to modify the pages. Cloudflare otherwise injects its own
# obfuscated bot-detection script (/cdn-cgi/challenge-platform/scripts/jsd/main.js) into every
# HTML page, which antivirus programs such as Avast flag as "HTML:Script-inf [Susp]".
<IfModule mod_headers.c>
    <FilesMatch "\.html?$">
        Header merge Cache-Control "no-transform"
    </FilesMatch>
</IfModule>

# Enable compression for faster loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php84" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
